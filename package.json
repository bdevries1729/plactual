{
  "name": "plactual",
  "version": "0.2.0",
  "description": "Sync Actual Budget server with banks via Plaid.",
  "license": "MIT",
  "author": "Ben DeVries",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "start": "node src/index.js",
    "dev": "nodemon --env-file=.env src/index.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@actual-app/api": "^26.8.1",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "node-cron": "^4.6.0",
    "plaid": "^42.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "nodemonConfig": {
    "ignore": [
      "db.json"
    ]
  }
}
